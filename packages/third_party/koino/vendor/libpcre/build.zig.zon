.{
    .name = .libpcre_zig,
    .version = "0.1.0",
    .dependencies = .{
        // Zag deviation (tui-markdown-001): upstream pins pcre by URL+hash;
        // path-vendored stock under ../pcre (see koino README.zag).
        .pcre = .{
            .path = "../pcre",
        },
    },
    .fingerprint = 0xc2f976f309fad70e,
    .minimum_zig_version = "0.15.1",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
